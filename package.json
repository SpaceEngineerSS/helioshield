{
  "name": "helioshield",
  "version": "2.0.0",
  "private": true,
  "description": "Live space weather from NOAA and NASA instruments, with replays of historic geomagnetic storms.",
  "license": "MIT",
  "author": "Mehmet Gümüş (https://github.com/SpaceEngineerSS)",
  "homepage": "https://helioshield.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/SpaceEngineerSS/helioshield.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite build && tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "archive": "tsx scripts/fetch-archive.ts",
    "fit:kp": "tsx scripts/fit-kp.ts",
    "icons": "tsx scripts/build-icons.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@react-three/fiber": "^9.5.0",
    "d3-geo": "^3.1.1",
    "idb": "^8.0.3",
    "motion": "^12.43.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "topojson-client": "^3.1.0",
    "uplot": "^1.6.32",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  }
}
